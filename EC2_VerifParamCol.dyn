  "Nodes": [
    {
      "ConcreteType": "DSRevitNodesUI.Categories, DSRevitNodesUI",
      "SelectedIndex": 36,
      "SelectedString": "OST_StructuralFraming",
      "Id": "02a8a1e90c134454bcc85e8dc9c181b6",
      "NodeType": "ExtensionNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "92cb2a2f89d0485194790094beeb8c02",
          "Name": "Category",
          "Description": "La categoría seleccionada",
          "UsingDefaultValue": false,
